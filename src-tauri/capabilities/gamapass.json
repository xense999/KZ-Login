{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "gamapass",
  "description": "GamaPass 登入視窗的外殼：只要拖曳與關閉。網頁那顆視窗（gamapass-view-*）刻意不在任何 capability 裡＝零 IPC，載入的是外部網站",
  "windows": ["gamapass-shell-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
